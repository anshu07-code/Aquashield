{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "services/**/*.ts"],
  "exclude": ["node_modules", "**/dist/**", "apps/**"]
}
